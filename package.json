{
  "name": "desk",
  "private": true,
  "version": "0.1.0",
  "description": "DESK: a single-player commodity trading game. A trader's desk on an accelerated clock with a curriculum.",
  "packageManager": "pnpm@10.32.0",
  "scripts": {
    "build": "pnpm -r --filter ./packages/** build && pnpm --filter @desk/web build",
    "test": "pnpm -r --filter ./packages/** test && pnpm --filter @desk/web test",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm --filter @desk/web dev",
    "e2e": "pnpm --filter @desk/web e2e",
    "screenshots": "pnpm --filter @desk/web screenshots"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
